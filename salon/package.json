{
  "name": "salon-line-concierge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "個人サロン向け LINE 自動応答・スタッフ転送 SaaS（Cloudflare Workers + Hono + D1）",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "db:local": "wrangler d1 migrations apply salon --local",
    "db:remote": "wrangler d1 migrations apply salon --remote"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260818.1",
    "@types/node": "^22.20.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.124.0"
  }
}
